# === PI Management - Production ===
# 복사하여 .env.prod 로 사용: cp .env.prod.example .env.prod

# Database
DB_USER=pi_user
DB_PASSWORD=change_this_password
DB_NAME=pi_management

# App (openssl rand -hex 32 로 생성)
SECRET_KEY=
ENVIRONMENT=production
DEBUG=false

# CORS (필요시 프론트엔드 도메인 추가)
CORS_ORIGINS_STR=

# Gunicorn 워커 수 (CPU 코어 수 x 2 + 1 권장)
WORKERS=2

# 외부 노출 포트
APP_PORT=8000
