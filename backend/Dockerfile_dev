FROM python:3.11-slim

WORKDIR /app

# 의존성 먼저 설치 (캐싱 최적화)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 소스 복사 (docker-compose에서 volume mount로 덮어씌워짐)
COPY . .

# entrypoint 스크립트 실행 권한
RUN chmod +x /app/entrypoint_dev.sh 2>/dev/null || true

# 개발 환경 기본값
ENV ENVIRONMENT=development
ENV DEBUG=true

EXPOSE 8000

# 개발 서버: DB 초기화 + hot-reload
CMD ["bash", "/app/entrypoint_dev.sh"]
