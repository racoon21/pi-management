# === PI Management - Development ===
# 복사하여 .env.dev 로 사용: cp .env.dev.example .env.dev

# Database
DB_USER=pi_user
DB_PASSWORD=pi_password
DB_NAME=pi_management

# App
SECRET_KEY=dev-secret-key-for-local-testing
ENVIRONMENT=development
DEBUG=true

# CORS (프론트엔드 개발 서버)
CORS_ORIGINS_STR=http://localhost:15173,http://127.0.0.1:15173
