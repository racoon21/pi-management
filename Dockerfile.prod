# ===========================================================
# PI Management — 프로덕션 멀티스테이지 빌드
# Stage 1: Frontend 빌드 (Node)
# Stage 2: Backend + 정적 파일 서빙 (Python)
# ===========================================================

# --- Stage 1: Frontend 빌드 ---
FROM node:20-alpine AS frontend-build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci --no-audit

COPY frontend/ ./
RUN npm run build


# --- Stage 2: Backend + Frontend 정적 파일 ---
FROM python:3.11-slim

# 보안: 비-루트 사용자 생성
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

WORKDIR /app

# 의존성 먼저 설치 (캐싱 최적화)
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Backend 소스 복사
COPY backend/ .

# Frontend 빌드 결과 복사
COPY --from=frontend-build /app/dist ./static

# entrypoint 스크립트 실행 권한
RUN chmod +x /app/entrypoint_prod.sh

# 소유권 변경
RUN chown -R appuser:appgroup /app

# 비-루트 사용자로 전환
USER appuser

# 환경변수 (기본값)
ENV ENVIRONMENT=production
ENV DEBUG=false

EXPOSE 8000

CMD ["bash", "/app/entrypoint_prod.sh"]
